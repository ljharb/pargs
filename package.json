{
	"name": "pargs",
	"version": "1.5.0",
	"description": "A useful wrapper for `util.parseArgs`",
	"main": "./index.mjs",
	"types": "./types.d.mts",
	"exports": {
		".": {
			"types": "./types.d.mts",
			"default": "./index.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"prepack": "npmignore --auto --commentLines=autogenerated",
		"prepublishOnly": "safe-publish-latest",
		"prepublish": "not-in-publish || npm run prepublishOnly",
		"lint": "eslint .",
		"postlint": "tsc && attw -P",
		"pretest": "npm run lint",
		"tests-only": "c8 tape 'test/**/*.*js'",
		"test": "npm run tests-only",
		"posttest": "npx npm@'>=10.2' audit --production",
		"version": "auto-changelog && git add CHANGELOG.md",
		"postversion": "auto-changelog && git add CHANGELOG.md && git commit --no-edit --amend && git tag -f \"v$(node -e \"console.log(require('./package.json').version)\")\"",
		"dependencies": "node -p \"process.env.npm_command\" | npx \"dt-clean@^1.2.2\" --auto"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ljharb/pargs.git"
	},
	"keywords": [
		"parseArgs",
		"parse",
		"arguments",
		"args",
		"pargs"
	],
	"author": "Jordan Harband <ljharb@gmail.com>",
	"funding": {
		"url": "https://github.com/sponsors/ljharb"
	},
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/ljharb/pargs/issues"
	},
	"homepage": "https://github.com/ljharb/pargs#readme",
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@ljharb/eslint-config": "^22.2.4",
		"@ljharb/tsconfig": "^0.3.2",
		"@types/node": "^22.20.2",
		"@types/object-inspect": "^1.13.0",
		"@types/tmp": "^0.2.6",
		"auto-changelog": "^2.6.1",
		"c8": "^11.0.0",
		"es-value-fixtures": "^1.7.1",
		"eslint": "^10.10.0",
		"in-publish": "^2.0.1",
		"npmignore": "^0.3.5",
		"object-inspect": "^1.13.4",
		"safe-publish-latest": "^2.0.0",
		"tape": "^5.10.2",
		"tmp": "^0.0.31",
		"typescript": "next"
	},
	"overrides": {
		"yargs@^17.7.2": "17.7.3-candidate.0"
	},
	"engines": {
		"node": "^22.20 || ^24.10 || >= 25"
	},
	"auto-changelog": {
		"output": "CHANGELOG.md",
		"template": "keepachangelog",
		"unreleased": false,
		"commitLimit": false,
		"backfillLimit": false,
		"hideCredit": true
	},
	"publishConfig": {
		"ignore": [
			".attw.json",
			".github/workflows",
			"eslint.config.mjs",
			".nycrc",
			"test",
			"tsconfig.json",
			"types"
		]
	}
}
